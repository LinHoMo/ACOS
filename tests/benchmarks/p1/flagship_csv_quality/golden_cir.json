        ]
      },
      "children": [],
      "elseChildren": [],
      "inputs": {
        "code": "import csv, json\npath = '${current_file}'\nwith open(path) as f:\n    rows = list(csv.DictReader(f))\ncols = [k for k in rows[0].keys() if k is not None] if rows else []\nissues = []\nfor i, r in enumerate(rows):\n    non_none_keys = [k for k in r.keys() if k is not None]\n    if len(non_none_keys) != len(cols): issues.append(f'row {i}: col count mismatch')\nhas_error = len(issues) > 0\nprint(json.dumps({'path': path, 'has_error': has_error, 'issues': issues, 'row_count': len(rows), 'columns': cols}))"
      }
    },
