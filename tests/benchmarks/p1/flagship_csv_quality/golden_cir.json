          {"name": "total_revenue", "typeName": "Number"},
          {"name": "row_count", "typeName": "Integer"},
          {"name": "category_counts", "typeName": "Record"}
        ]
      },
      "children": [],
      "elseChildren": [],
      "inputs": {
        "code": "import csv, json\nfrom collections import Counter\npath = '${current_file}'\nwith open(path) as f:\n    rows = list(csv.DictReader(f))\ncats = Counter(r.get('category','') for r in rows)\ntotal_rev = sum(float(r.get('revenue',0) or 0) for r in rows)\nprint(json.dumps({'path': path, 'total_revenue': total_rev, 'row_count': len(rows), 'category_counts': dict(cats)}))"
      },
      "control": {
        "retry": {
