          {"name": "repaired", "typeName": "Boolean"},
          {"name": "rows_cleaned", "typeName": "Integer"}
        ]
      },
      "children": [],
      "elseChildren": [],
      "inputs": {
        "code": "import csv, json\npath = '${current_file}'\nwith open(path, newline='') as f:\n    rows = list(csv.DictReader(f))\ncleaned = []\nfor r in rows:\n    cleaned.append({(k.strip() if k else k): (v.strip() if isinstance(v,str) and v else v) for k,v in r.items() if k is not None})\nprint(json.dumps({'path': path, 'repaired': True, 'rows_cleaned': len(cleaned)}))"
      }
    },
