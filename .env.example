# ACOS 本地环境配置 / Local Environment Configuration
#
# 复制此文件为 .env 并填入实际值：cp .env.example .env
# 服务器启动时会自动加载 .env 中的变量。

# ── LLM 提供者（龙猫代理）───────────────────────────────────────────────
# API key。也可通过环境变量 LONGCAT_API_KEY / ANTHROPIC_API_KEY 设置。
LONGCAT_API_KEY=

# API base URL（可选，默认 https://api.longcat.chat/anthropic）
# LONGCAT_BASE_URL=https://api.longcat.chat/anthropic

# 模型 ID（可选，默认 LongCat-2.0）
# ACOS_LLM_MODEL=LongCat-2.0

# ── 服务器 ───────────────────────────────────────────────────────────────
# Web 服务器端口（默认 8080）
# ACOS_PORT=8080

# ── 规划器默认行为 ───────────────────────────────────────────────────────
# 设为 true 则默认使用规则规划器（无需 API key）
# ACOS_DEFAULT_RULES=false
